{
  "name": "noemi-survey-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-env.mjs && vite build",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run --environment jsdom src",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/setup-playwright.mjs",
    "safe:refactor": "tsx scripts/safe-refactor.ts",
    "format": "prettier --write .",
    "lint:safe": "eslint . --no-error-on-unmatched-pattern || true",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest run --reporter=dot --environment jsdom src",
    "e2e:ci": "playwright test --reporter=dot || true",
    "bundle:report": "source-map-explorer 'dist/assets/*.js' --html analyzer.html || true",
    "schema:check": "node scripts/check-schema.mjs",
    "schema:verify": "node scripts/check-schema.mjs",
    "db:seed": "node scripts/seed-designs.mjs",
    "db:seed:dry": "node scripts/seed-designs.mjs --dry-run"
  },
  "dependencies": {
    "@react-spring/web": "^9.7.5",
    "@supabase/supabase-js": "^2.54.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.8.0",
    "react-tinder-card": "1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.4",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "globby": "^14.1.0",
    "jsdom": "^24.0.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.6.2",
    "source-map-explorer": "^2.5.3",
    "terser": "^5.43.1",
    "ts-morph": "^26.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20.11.1",
    "pnpm": "8.10.5"
  },
  "packageManager": "pnpm@8.10.5"
}
