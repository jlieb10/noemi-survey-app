{
  "version": "1.0.2",
  "brand": {
    "name": "NOEMI",
    "instagram": "@noemi",
    "voice": {
      "tone": ["luxury", "elegant", "inclusive", "mystical"],
      "keywords": [
        "self-care",
        "wellness",
        "functional beauty",
        "ritual",
        "alchemy"
      ]
    }
  },
  "survey": {
    "meta": {
      "title": "Thank you for sharing your thoughts",
      "subtitle": "Enjoy early access to exclusive products and offers",
      "estimated_time_seconds": 150,
      "language": "en-GB",
      "start_cta": "Begin",
      "end_cta": "Continue"
    },
    "consent": {
      "show_at_start": true,
      "checkbox_label": "I agree to the privacy notice",
      "required": true
    }
  },
  "questions": [
    {
      "id": "q1",
      "title": "All About You",
      "type": "group",
      "sub_questions": [
        {
          "id": "q1a",
          "label": "Your name (optional)",
          "type": "short_text",
          "placeholder": "",
          "required": false
        },
        {
          "id": "q1b",
          "label": "Your age",
          "type": "number",
          "min": 16,
          "max": 99,
          "placeholder": "e.g., 36",
          "required": false
        },
        {
          "id": "q1c",
          "label": "Your gender",
          "type": "select",
          "options": [
            "Woman",
            "Man",
            "Non-binary",
            "Prefer not to say"
          ],
          "required": false
        },
        {
          "id": "q1d",
          "label": "Email",
          "type": "email",
          "marketing_consent": {
            "default_checked": true,
            "incentive": "Unlock exclusive offers and enter to win a year of NOEMI",
            "tooltip": "We’ll only send you NOEMI news and offers. You can unsubscribe anytime."
          },
          "required": false
        },
        {
          "id": "q1e",
          "label": "I currently buy or use… (select all that apply)",
          "type": "checkbox",
          "options": [
            "Vitamins",
            "Supplements",
            "Functional blends",
            "Functional food",
            "None of the above, but I'm curious",
            "None of the above and not interested"
          ],
          "required": true
        },
        {
          "id": "q1f",
          "label": "My wellness indulgences include… (select all that apply)",
          "type": "checkbox",
          "options": [
            "Yoga or Pilates",
            "Candles or aromatherapy",
            "At-home spa self-care (baths, scrubs, masks, sauna)",
            "Breathwork, reiki, and traditional wellness",
            "Meditation apps or mindfulness tools",
            "Other wellness or spiritual practices (please specify)",
            "None of the above"
          ],
          "required": true
        }
      ]
    },
    {
      "id": "q2",
      "type": "multi_select",
      "prompt": "What do you most want more of right now?",
      "required": true,
      "ui_hint": "chips",
      "max_select": 3,
      "randomize": true,
      "options": [
        { "id": "sleep", "label": "Deeper sleep" },
        { "id": "mood", "label": "Steadier mood" },
        { "id": "stress", "label": "Less stress" },
        { "id": "energy", "label": "Calm energy" },
        { "id": "glow", "label": "Glowing skin" },
        { "id": "focus", "label": "Sharper focus" },
        { "id": "immunity", "label": "Stronger immunity" },
        { "id": "digestion", "label": "Better digestion" },
        { "id": "longevity", "label": "Healthy ageing" },
        { "id": "metabolism", "label": "Metabolic & nutritional health" }
      ]
    },
    {
      "id": "q3",
      "type": "single_select",
      "prompt": "What is your style of self-care?",
      "required": true,
      "ui_hint": "chips",
      "randomize": true,
      "options": [
        { "id": "style_minimal", "label": "Minimal & effortless" },
        { "id": "style_sensory_ritual", "label": "Considered & sensory (rituals)" },
        { "id": "style_science", "label": "Science-based & clinical" },
        { "id": "style_natural_traditional", "label": "Nature-first & traditional" },
        { "id": "style_functional", "label": "Functional & results-focused" },
        { "id": "style_biohacker", "label": "Data-driven / biohacking" },
        { "id": "style_practitioner", "label": "Practitioner- or protocol-led" },
        { "id": "style_convenience", "label": "Convenient & on-the-go" },
        { "id": "style_flexible", "label": "Flexible / situational" }
      ]
    },
    {
      "id": "q4",
      "type": "multi_select",
      "prompt": "When thinking about wellness formulas, which formats and routines fit you best? (select all that apply)",
      "required": true,
      "ui_hint": "chips",
      "options": [
        { "id": "capsules_daily", "label": "Capsules" },
        { "id": "gummies_daily", "label": "Gummies" },
        { "id": "drink_daily", "label": "Ready-to-drink" },
        { "id": "powder_flexible", "label": "Powder to mix" },
        { "id": "occasional_other", "label": "Other occasional" },
        { "id": "no_preference", "label": "No strong preference" }
      ]
    },
    {
      "id": "q6",
      "type": "single_select",
      "prompt": "When it comes to wellness formulas, which approach feels most appealing to you?",
      "required": true,
      "ui_hint": "chips",
      "options": [
        { "id": "tradition", "label": "Traditional wisdom & natural remedies" },
        { "id": "evidence", "label": "Scientific evidence & clinical research" },
        { "id": "blend", "label": "A blend of both" }
      ]
    },
    {
      "id": "q7",
      "type": "scale",
      "prompt": "When choosing supplements, which style of labeling feels more appealing?",
      "required": true,
      "min": 1,
      "max": 5,
      "left": "Ingredient-led (e.g., Vitamin B12, Vitamin B6)",
      "right": "Function-led (e.g., 'Energy Support' blends)"
    },
    {
      "id": "q8",
      "type": "single_select",
      "prompt": "How much do sensory details (taste, smell, look and feel) matter to you in wellness formulas?",
      "required": true,
      "ui_hint": "chips",
      "options": [
        { "id": "high", "label": "They matter a lot" },
        { "id": "medium", "label": "I notice them sometimes" },
        { "id": "low", "label": "They don’t influence my choice" }
      ]
    },
    {
      "id": "q9",
      "type": "multi_select",
      "prompt": "If a wellness formula truly worked for you, under what conditions would you consider a monthly subscription (cancel anytime)?",
      "required": true,
      "ui_hint": "chips",
      "options": [
        { "id": "no", "label": "I wouldn’t subscribe" },
        { "id": "trial_first", "label": "I’d want to try one-off first" },
        { "id": "discount", "label": "If there were a substantial discount" },
        { "id": "lt50", "label": "If it were under £50/month" },
        { "id": "lt75", "label": "If it were under £75/month" },
        { "id": "lt100", "label": "If it were under £100/month" },
        { "id": "any_price", "label": "Price doesn’t matter, if it truly worked for me" }
      ]
    },
    {
      "id": "q10",
      "type": "multi_select",
      "prompt": "What would make you more likely to try a new wellness formula?",
      "required": true,
      "ui_hint": "chips",
      "max_select": 3,
      "randomize": true,
      "options": [
        { "id": "recommendation", "label": "Recommendation from a trusted source" },
        { "id": "influencer", "label": "Influencer endorsement" },
        { "id": "brand_reputation", "label": "Brand reputation" },
        { "id": "scientific_evidence", "label": "Scientific evidence or studies" },
        { "id": "sustainability", "label": "Sustainability and ethical sourcing" },
        { "id": "aesthetics", "label": "Aesthetically pleasing packaging" },
        { "id": "free_sample", "label": "Free sample or trial experience" },
        { "id": "reviews", "label": "Positive customer reviews" }
      ]
    },
    {
      "id": "q11",
      "type": "multi_select",
      "prompt": "Which of these labels or ingredients would appeal to you on a wellness formula? (Choose up to 8)",
      "required": false,
      "ui_hint": "ingredient_grid",
      "max_select": 8,
      "layout": "two_columns",
      "randomize": true,
      "options": [
        { "id": "ingredient_vitamin_d3", "label": "Vitamin D3" },
        { "id": "ingredient_magnesium", "label": "Magnesium" },
        { "id": "ingredient_omega_3", "label": "Omega-3" },
        { "id": "ingredient_probiotic", "label": "Probiotics" },
        { "id": "beauty_collagen", "label": "Collagen" },

        { "id": "branded_ubiquinol", "label": "Ubiquinol® (CoQ10)" },
        { "id": "branded_suntheanine", "label": "Suntheanine® (L-Theanine)" },
        { "id": "science_creatine", "label": "Creatine" },

        { "id": "traditional_ashwagandha", "label": "Ashwagandha" },
        { "id": "traditional_ginseng", "label": "Ginseng" },
        { "id": "science_curcumin", "label": "Curcumin" },

        { "id": "nootropic_rhodiola", "label": "Rhodiola" },
        { "id": "nootropic_lions_mane", "label": "Lion’s Mane" },
        { "id": "exotic_schisandra", "label": "Schisandra" },

        { "id": "function_sleep", "label": "Sleep Support" },
        { "id": "function_energy", "label": "Energy Support" },
        { "id": "function_mood", "label": "Mood Support" },
        { "id": "function_immunity", "label": "Immunity Support" },

        { "id": "label_traditional", "label": "Traditional remedies" },
        { "id": "label_clinical", "label": "Clinically researched" }
      ]
    }
  ],
  "design_feedback": {
    "title": "NOEMI Brand Exploration",
    "subtitle": "Swipe to help us refine what feels most NOEMI",
    "intro": "We're seeking your intuition to help shape our design and brand concepts"
  },
  "game_tutorial": {
    "welcome_card": "Welcome to the NOEMI Brand Exploration game! Swipe to help us refine what feels most NOEMI. Continue by swiping this card up.",
    "card_one": "Swipe right to like ",
    "card_two": "Swipe left to dislike",
    "card_three": "Swipe up to love",
    "card_four": "Swipe down for not sure"
  }
}
